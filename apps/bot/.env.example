DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Your Discord user ID — the single bot owner, allowed everything everywhere
OWNER_ID=

# Admin hub — every server's logs are mirrored to this channel. Leave unset to skip mirroring
ADMIN_GUILD_ID=
ADMIN_LOG_CHANNEL_ID=

# Public base URL of apps/api, for embed builder links (e.g. https://bedge.example.com). Leave unset to hand out bare draft codes
BUILDER_URL=

# Database
# Local dev (pnpm dev):      mongodb://localhost:27017/bedge
# Docker (docker compose up): mongodb://mongo:27017/bedge  ← set automatically by compose
MONGODB_URI=mongodb://localhost:27017/bedge

# Logger — see packages/logger for full config reference
# LOG_CONSOLE_LEVEL: verbose | debug | info | warn | error | fatal
LOG_CONSOLE_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/bedge-bot.log
# LOG_FILE_FORMAT: text | json
LOG_FILE_FORMAT=text
LOG_DISCORD_ENABLED=false
# Set DISCORD_WEBHOOK_URL to enable Discord log notifications (errors+ by default)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_USERNAME=bedge-bot logger
LOG_SHOW_ENV=false
# force ANSI colors through pnpm process chain
FORCE_COLOR=3
