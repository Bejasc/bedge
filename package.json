{
  "name": "bedge-bot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "predev": "docker compose up mongo -d --wait",
    "dev": "pnpm --filter bot dev",
    "postdev": "docker compose down -v",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter \"./apps/**\" test",
    "test:coverage": "pnpm -r --filter \"./apps/**\" test:coverage",
    "start": "pnpm --filter bot start",
    "generate:schema": "pnpm --filter @bedge/types generate:schema"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
