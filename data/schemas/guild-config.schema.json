{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "guildId": {
      "type": "string"
    },
    "defaultLogChannelId": {
      "type": "string"
    },
    "logs": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "members": {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "moderation": {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "voice": {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "server": {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "messages",
        "members",
        "moderation",
        "voice",
        "server"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "properties": {
        "modRoleId": {
          "type": "string"
        },
        "adminRoleId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "guildId",
    "logs",
    "roles"
  ],
  "additionalProperties": false
}
